# Copy to .env (gitignored) and fill in values.

# Required for LLM experiments (RQ1 LLM arm, RQ2). Get free key at:
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional — pin a specific model for reproducibility.
# Check current free models: https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=openai/gpt-oss-120b:free
